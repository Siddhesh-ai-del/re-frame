{
  "name": "reframe-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "./node_modules/.bin/vite",
    "build": "./node_modules/.bin/tsc -b && ./node_modules/.bin/vite build",
    "preview": "./node_modules/.bin/vite preview",
    "test": "./node_modules/.bin/vitest run",
    "test:coverage": "./node_modules/.bin/vitest run --coverage",
    "typecheck": "./node_modules/.bin/tsc -b",
    "lint": "./node_modules/.bin/eslint .",
    "e2e": "./node_modules/.bin/playwright test",
    "prepare": "./node_modules/.bin/openapi-typescript src/api/schema.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.4",
    "vitest": "^3.2.4"
  }
}
