            "type": "string",
            "title": "Type"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "detected_at": {
            "type": "string",
            "title": "Detected At"
          },
          "serious": {
            "type": "boolean",
            "title": "Serious"
          },
          "followup_due_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Followup Due At"
          },
          "followup_completed": {
            "type": "boolean",
            "title": "Followup Completed"
          },
