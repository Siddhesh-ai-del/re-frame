          },
          "serious_in_window": {
            "type": "integer",
            "title": "Serious In Window"
          },
          "overdue_serious_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Overdue Serious Ids"
          }
        },
        "type": "object",
        "required": [
          "in_window",
          "per_week",
          "by_type",
          "by_source",
          "serious_in_window",
          "overdue_serious_ids"
        ],
        "title": "AeSummaryOut",
        "description": "In-window adverse-event rollups: ids and counts only (D1)."
      },
      "AnswerOptionOut": {
