            "minLength": 1,
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "description": "Inbound chat body: a single length-bounded user message, nothing else."
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "route": {
            "type": "string",
            "title": "Route"
          },
          "module_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Module Ids"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Violations"
          },
          "resources": {
            "items": {
              "$ref": "#/components/schemas/ResourceOut"
