          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "serious": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serious"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ],
        "title": "AdverseEventCreateIn",
        "description": "Inbound reviewer record: known-shape fields only; source is NOT accepted (D4)."
      },
      "AdverseEventListOut": {
        "properties": {
          "adverse_events": {
            "items": {
              "$ref": "#/components/schemas/AdverseEventOut"
