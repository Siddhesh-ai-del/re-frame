          "reply",
          "route",
          "module_ids",
          "violations",
          "resources"
        ],
        "title": "ChatResponse",
        "description": "Outbound chat result: the reply, its route, grounding, and resources."
      },
      "CheckInListOut": {
        "properties": {
          "checkins": {
            "items": {
              "$ref": "#/components/schemas/CheckInOut"
            },
            "type": "array",
            "title": "Checkins"
          }
        },
        "type": "object",
        "required": [
          "checkins"
        ],
        "title": "CheckInListOut",
        "description": "Chronological check-in history for one instrument."
      },
      "CheckInOut": {
        "properties": {
          "instrument_id": {
            "type": "string",
            "title": "Instrument Id"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "responses": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Responses"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "severity_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity Label"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "instrument_id",
          "date",
          "responses",
          "total",
          "severity_label",
          "flags",
          "action",
          "message_id",
          "message"
        ],
        "title": "CheckInOut",
        "description": "One recorded check-in: raw data, score, flags, and its routing decision.\n\n``action``/``message_id``/``message`` come from the pre-specified routing\ntable applied to this check-in's flags — the client escalates on these,\nnever on ``total`` alone. ``message`` is ``None`` exactly when the route\nis ``proceed``."
      },
      "CheckInPurgeOut": {
        "properties": {
          "deleted": {
            "type": "integer",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "deleted"
        ],
        "title": "CheckInPurgeOut",
        "description": "Result of purging every recorded check-in: how many rows were removed."
      },
      "CheckInRequest": {
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1,
