            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "tier": {
            "type": "string",
            "title": "Tier"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Steps"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "contraindications": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contraindications"
          },
          "early_worsening_notice": {
            "type": "boolean",
            "title": "Early Worsening Notice"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "category",
          "tier",
          "steps",
          "sources",
          "contraindications",
          "early_worsening_notice"
        ],
        "title": "ExerciseOut",
        "description": "One exercise module on the wire.\n\nMirrors the library module exactly EXCEPT ``safety_class`` — that is an\ninternal routing decision (self-help vs referral-only) and is never\nexposed to clients."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
