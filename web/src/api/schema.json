        ],
        "title": "AdverseEventOut",
        "description": "One logged adverse event on the wire: metadata and locators only (D1)."
      },
      "AeSummaryOut": {
        "properties": {
          "in_window": {
            "type": "integer",
            "title": "In Window"
          },
          "per_week": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Per Week"
          },
          "by_type": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "By Type"
          },
          "by_source": {
            "additionalProperties": {
              "type": "integer"
