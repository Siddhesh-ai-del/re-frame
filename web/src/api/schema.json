{
  "openapi": "3.1.0",
  "info": {
    "title": "RE:FRAME API",
    "description": "RE:FRAME is a wellness companion API for emotional distress self-management, offering grounded, evidence-informed exercise support behind a layered safety system.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/resources": {
      "get": {
        "summary": "Resources",
        "description": "Serve the standing crisis resources.\n\nDeliberately independent of ``pipeline`` (and therefore of the LLM):\nthese links must stay reachable even when generation is down — the UI\nshows them on the 503 path, so this endpoint can never fail the same\nway chat does.",
        "operationId": "resources_resources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourcesOut"
                }
              }
            }
          }
        }
      }
    },
    "/content/exercises": {
      "get": {
        "summary": "Content Exercises",
        "description": "Serve the full exercise library (stage 6c).\n\nThe path is ``/content/exercises`` (not ``/exercises``) precisely\nbecause the SPA owns GET ``/exercises`` — a same-path API route could\nnot be disambiguated by method the way ``POST /chat`` is. Served from\nthe packaged, cached library; no LLM involved, so it stays reachable\non the 503 path.",
        "operationId": "content_exercises_content_exercises_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseListOut"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/instruments": {
      "get": {
        "summary": "List Instruments",
        "operationId": "list_instruments_instruments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentListOut"
                }
              }
            }
          }
        }
      }
    },
    "/checkins": {
      "post": {
        "summary": "Record Checkin",
        "operationId": "record_checkin_checkins_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Purge Checkins",
        "description": "Purge every recorded check-in and return how many were removed.\n\nRouted through ``tracker.delete_all`` so the durable tracker empties\nits SQLite store and its in-memory mirror together (no rows can\nresurrect on restart) while the in-memory dev tracker empties its\nrecords. The route takes no path parameter, so there is no\ninstrument-id to validate: the per-instrument 404 contract of\n``GET /checkins/{instrument_id}`` is unchanged.",
        "operationId": "purge_checkins_checkins_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInPurgeOut"
                }
              }
            }
          }
        }
      }
    },
    "/checkins/{instrument_id}": {
      "get": {
        "summary": "Checkin History",
        "operationId": "checkin_history_checkins__instrument_id__get",
        "parameters": [
          {
            "name": "instrument_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Instrument Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInListOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/adverse-events": {
      "get": {
        "summary": "List Adverse Events",
        "description": "List every logged adverse event in insertion order (metadata only).",
        "operationId": "list_adverse_events_evaluation_adverse_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdverseEventListOut"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Record Adverse Event",
        "description": "Record one reviewer-entered adverse event (source stamped ``review``).\n\nThe body's ``serious`` (when present) overrides the pre-specified\ntaxonomy default (D2); ``reference`` must be a locator, never\nmessage content (D1). Failures map to a generic 422; nothing about\nthe record's internals reaches the wire.",
        "operationId": "record_adverse_event_evaluation_adverse_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdverseEventCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdverseEventOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/adverse-events/{event_id}/followup": {
      "post": {
        "summary": "Complete Adverse Event Followup",
        "description": "Mark an adverse event's follow-up completed (the 48-hour marker, D3).\n\nBody-free by design: the call itself records that a reviewer\naddressed the event. Unknown ids are a generic 404 — a follow-up\nagainst an unlogged id is a loud failure, never a silent no-op.",
        "operationId": "complete_adverse_event_followup_evaluation_adverse_events__event_id__followup_post",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdverseEventOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/report": {
      "get": {
        "summary": "Evaluation Report",
        "description": "Assemble the feasibility report (operational parameters only).",
        "operationId": "evaluation_report_evaluation_report_get",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "name": "expected_per_week",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Expected Per Week"
            }
          },
          {
            "name": "planned",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Planned"
            }
          },
          {
            "name": "enrolled",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Enrolled"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdverseEventCreateIn": {
        "properties": {
          "type": {
