          "value": {
            "type": "integer",
            "title": "Value"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "title": "AnswerOptionOut",
        "description": "One labelled answer option on the instrument's scale."
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
