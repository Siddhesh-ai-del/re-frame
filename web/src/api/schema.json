          },
          "responses": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "minItems": 1,
            "title": "Responses"
          },
          "date": {
            "type": "string",
            "title": "Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "instrument_id",
          "responses",
          "date"
        ],
        "title": "CheckInRequest",
        "description": "Inbound check-in body: known-shape fields only, strict ISO date."
